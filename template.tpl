___TESTS___

scenarios:
- name: Sends the event to cbq with mapped values
  code: |-
    const mockData = {
      trackingKey: 'mmtrk_test',
      eventName: 'purchase',
      tagOnPage: 'page',
      readEcommerce: false,
      orderParams: [{name: 'transaction_id', value: '2005'}, {name: 'tax', value: 4.1}],
      userData: [{name: 'email', value: 'asha@example.com'}, {name: 'city', value: 'Pune'}]
    };
    let sent;
    mock('createArgumentsQueue', () => function() { sent = arguments; });
    runCode(mockData);
    assertThat(sent[0]).isEqualTo('event');
    assertThat(sent[1]).isEqualTo('purchase');
    assertThat(sent[2].transaction_id).isEqualTo('2005');
    assertThat(sent[2].user_data.city).isEqualTo('Pune');
    assertApi('gtmOnSuccess').wasCalled();
    assertApi('injectScript').wasNotCalled();
- name: Loads the tag when asked to
  code: |-
    const mockData = { trackingKey: 'mmtrk_test', eventName: 'custom', customEventName: 'quiz_completed', tagOnPage: 'load', readEcommerce: false };
    mock('createArgumentsQueue', () => function() {});
    mock('injectScript', (url, ok) => { ok(); });
    runCode(mockData);
    assertApi('injectScript').wasCalled();
    assertApi('gtmOnSuccess').wasCalled();


